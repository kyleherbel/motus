          "type": "number",
          "optional": true
        },
        "word": {
          "type": "word",
          "optional": true
        },
        "prefix": {
          "type": "string",
          "optional": true,
          "maxChars": 2
        },
        "suffix": {
          "type": "string",
          "optional": true,
          "maxChars": 8
        },
        "label": {
          "type": "string",
          "optional": true,
          "maxChars": 22,
          "maxWords": 4
        },
        "plate": "enum?:pale|white|dark|navy|warm|teal|field",
        "field": {
          "type": "string",
          "optional": true,
          "maxChars": 7
        }
      },
      "beats": {}
    },
