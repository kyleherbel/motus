        "export interface MatchResult {",
        "  matched: boolean;",
        "  keyword: string | null;",
        "}",
        "",
        "export function matchKeyword(",
        "  text: string,",
        "  keywords: string[],",
        "): MatchResult {",
        "  const words = text.toLowerCase().split(' ');",
        "  for (const k of keywords) {",
        "    if (words.includes(k)) {",
        "      return { matched: true, keyword: k };",
        "    }",
        "  }",
        "  return { matched: false, keyword: null };",
        "}"
